      "cell_type": "code",
      "source": [
        "# 12.\tCreate an array and demonstrate the difference between a slice/view and a copy\n",
        "\n",
        "\n",
        "# Create an array\n",
        "arr = np.array([10, 20, 30, 40, 50])\n",
        "\n",
        "# Slice / View\n",
        "view = arr[1:4]\n",
        "\n",
        "# Copy\n",
        "copy = arr[1:4].copy()\n",
        "\n",
        "# Change the view\n",
        "view[0] = 100\n",
        "\n",
        "# Change the copy\n",
        "copy[1] = 200\n",
        "\n",
        "print(\"Original array:\", arr)\n",
        "print(\"View:\", view)\n",
        "print(\"Copy:\", copy)"
      ],
      "metadata": {
        "colab": {
